<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.hjq.bar.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent" android:layout_height="45dp"
        android:background="@android:color/transparent"
        app:title="关于" app:titleStyle="bold" app:titleColor="@color/text_foreground"
        app:lineVisible="false" />
    <include layout="@layout/dialog_about"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp" />
</LinearLayout>
