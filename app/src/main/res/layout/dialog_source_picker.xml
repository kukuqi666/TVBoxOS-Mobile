<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none" android:background="@drawable/bg_large_round_popup">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/source_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_foreground" />
            <com.google.android.material.button.MaterialButton android:id="@+id/source_cancel" android:layout_width="wrap_content"
                android:layout_height="48dp" android:text="完成" style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="当前地址" android:textColor="@color/text_sub_foreground" android:textSize="12sp" />
            <TextView android:id="@+id/source_current_url" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/text_foreground" android:textSize="14sp"
                android:textIsSelectable="true" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/light_gray_color" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/source_saved_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/text_sub_foreground" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/source_add" android:layout_width="wrap_content"
                android:layout_height="48dp" android:text="添加来源" style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
        <TextView android:id="@+id/source_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp"
            android:text="还没有保存来源" android:textColor="@color/text_sub_foreground" android:textSize="13sp" android:gravity="center" />
        <LinearLayout android:id="@+id/source_saved" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/source_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="8dp" android:textSize="12sp" android:textColor="@color/text_sub_foreground" android:visibility="gone" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/light_gray_color" />
        <TextView android:id="@+id/source_existing" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:text="从视频订阅选择" android:textColor="@color/text_foreground"
            android:textSize="14sp" android:foreground="?android:selectableItemBackground" />
        <TextView android:id="@+id/source_file" android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:text="导入本地文件" android:textColor="@color/text_foreground"
            android:textSize="14sp" android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
</ScrollView>
